{
  "name": "obsidian-community-releases",
  "version": "0.1.0",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "rimraf dist release",
    "format": "prettier --write \"**/community*.json\"",
    "dev": "vite --config app/renderer/vite.config.ts",
    "typecheck": "tsc -p app/renderer/tsconfig.json --noEmit",
    "build:main": "tsc -b app/main app/preload",
    "build:renderer": "vite build --config app/renderer/vite.config.ts",
    "build": "npm run clean && npm run typecheck && npm run build:main && npm run build:renderer",
    "preview": "vite preview --config app/renderer/vite.config.ts",
    "package:win": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.2.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.24.0",
    "clsx": "^2.1.1",
    "marked": "^12.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.obsidian.flint",
    "productName": "Obsidian Flint",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/shared/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
