{
  "name": "obsidian-community-releases",
  "scripts": {
    "format": "prettier --write \"**/community*.json\"",
    "dev": "vite --config app/renderer/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config app/renderer/vite.config.ts",
    "preview": "vite preview --config app/renderer/vite.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.2.3",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/history": "^0.19.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.24.0",
    "clsx": "^2.1.1",
    "marked": "^12.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^34.1.1",
    "prettier": "3.5.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
